---
import Tabs from './Tabs.astro';
import TabItem from './TabItem.astro';
import Code from './Code.astro';
import { installTabs } from '@/lib/pm.mjs';

interface Props {
  npm: string[]; pnpm: string[]; yarn: string[]; bun: string[]; deno: string[];
}
const tabs = installTabs(Astro.props as unknown as Record<string, string[]>);
---
<Tabs syncKey="command">
  {tabs.map(t => <TabItem label={t.pm}><Code code={t.code} lang="bash" frame="none" showLineNumbers={false} /></TabItem>)}
</Tabs>
