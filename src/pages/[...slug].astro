---
import { getCollection, render } from 'astro:content';
import Docs from '../layouts/Docs.astro';
import { ORDER } from '../lib/nav.mjs';

export async function getStaticPaths() {
  const entries = await getCollection('docs', ({ id }) => id !== '404');
  return entries.map(entry => ({
    params: { slug: entry.id.replace(/\/index$/, '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const all = await getCollection('docs');
const titles = Object.fromEntries(all.map(e => [e.id, e.data.title]));
---
<Docs title={entry.data.title} description={entry.data.description} id={entry.id} titles={titles} toc={entry.data.toc}>
  <Content />
</Docs>
